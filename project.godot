; Engine configuration file.
config_version=5

[application]

config/name="Compagnie du Corbeau"
config/description="Jeu tactique de mercenaires au tour par tour, inspiré de Battle Brothers."
config/icon="res://assets/app_icon.svg"
boot_splash/bg_color=Color(0.109804, 0.0980392, 0.0823529, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/use_filter=true
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Data="*res://autoload/Data.gd"
Game="*res://autoload/Game.gd"
Settings="*res://autoload/Settings.gd"
Audio="*res://autoload/Audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_2d=2
