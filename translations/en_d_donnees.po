msgstr "Crossbow in hand: +5 % to hit, Aimed Shot costs 1 less AP; unlocks \"Piercing Bolt\" (armor ×1.3, penetrates 15 more points)."

msgid "Arbalète légère"
msgstr "Light crossbow"

msgid "Arbalètes"
msgstr "Crossbows"

msgid "Arbalètes : la recharge coûte 2 PA et 3 fatigue de moins, traversent 10 points de plus l'armure."
msgstr "Crossbows: reloading costs 2 fewer AP and 3 less fatigue, penetrating 10 more points of armor."

msgid "Arbalétrier"
msgstr "Crossbowman"

msgid "Arbalétrier perce-armure"
msgstr "Armor-piercing crossbowman"

