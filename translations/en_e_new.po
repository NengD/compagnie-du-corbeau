msgstr "%s: choice \"%s\" without \"label\" (discarded)."

msgid "%s : choix « %s » : « check.kind » doit être %s (écarté)."
msgstr "%s: choice \"%s\": \"check.kind\" must be %s (discarded)."

msgid "%s : choix « %s » : « %s » doit lister 1 à 4 issues (écarté)."
msgstr "%s: choice \"%s\": \"%s\" must list 1 to 4 outcomes (discarded)."

msgid "%s : choix « %s » : « outcomes » doit lister 1 à 5 issues (écarté)."
msgstr "%s: choice \"%s\": \"outcomes\" must list 1 to 5 outcomes (discarded)."

