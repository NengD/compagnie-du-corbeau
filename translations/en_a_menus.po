msgid " C'est une partie en mode fer : elle sera perdue définitivement."
msgstr " This is an ironman game: it will be lost for good."

msgid " — mort définitive stricte"
msgstr " — strict permadeath"

msgid " — ⛓ Mode fer"
msgstr " — ⛓ Ironman mode"

msgid "%d i/s"
msgstr "%d fps"

msgid "%d jours"
msgstr "%d day|%d days"

msgid "%d succès sur %d débloqués. Ils sont conservés d'une partie à l'autre."
msgstr "%d of %d achievements unlocked. They carry over from one game to the next."

