msgid "%s est brisé. Le royaume respire, et l'on chantera longtemps le nom de la Compagnie du Corbeau — celui de ceux qui sont tombés en chemin aussi."
msgstr "%s is broken. The kingdom breathes again, and the name of the Raven Company will be sung for a long time — and the names of those who fell along the way, too."

msgid "%s — objectif atteint"
msgstr "%s — objective reached"

msgid "%s — échec"
msgstr "%s — failed"

